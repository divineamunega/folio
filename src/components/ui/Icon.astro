---
/**
 * Icon Component
 * SVG icon wrapper with consistent sizing
 */

interface Props {
  name: "arrow-right" | "arrow-left" | "arrow-down" | "external" | "check" | "play";
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { name, size = "md", class: className = "" } = Astro.props;

const sizeMap = {
  sm: "w-3 h-3",
  md: "w-4 h-4",
  lg: "w-5 h-5",
};

const icons = {
  "arrow-right": "M9 5l7 7-7 7",
  "arrow-left": "M15 19l-7-7 7-7",
  "arrow-down": "M19 9l-7 7-7-7",
  external: "M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14",
  check: "M5 13l4 4L19 7",
  play: "M8 5v14l11-7z",
};
---

<svg
  class={`${sizeMap[size]} ${className}`}
  fill={name === "play" ? "currentColor" : "none"}
  stroke={name === "play" ? "none" : "currentColor"}
  viewBox="0 0 24 24"
>
  <path
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    d={icons[name]}></path>
</svg>
