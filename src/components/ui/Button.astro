---
/**
 * Button Component
 * Reusable button with consistent styling
 */

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  ariaLabel?: string;
  external?: boolean;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  ariaLabel,
  external = false,
} = Astro.props;

const baseStyles =
  "inline-flex items-center gap-3 font-medium transition-all duration-300 hover:gap-4 border-2";

const variantStyles = {
  primary:
    "bg-text-main text-bg-base border-text-main hover:opacity-90",
  secondary:
    "bg-transparent border-text-main text-text-main hover:bg-text-main/5",
  ghost:
    "bg-transparent border-transparent text-text-main hover:border-text-main/10",
};

const sizeStyles = {
  sm: "px-4 py-2 text-sm",
  md: "px-8 py-4 text-base",
  lg: "px-10 py-5 text-lg",
};

const classes = `${baseStyles} ${variantStyles[variant]} ${sizeStyles[size]} ${className}`;

const externalProps = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

{
  href ? (
    <a href={href} class={classes} aria-label={ariaLabel} {...externalProps}>
      <slot />
      <svg
        class="w-4 h-4 transition-transform group-hover:translate-x-1"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"
        />
      </svg>
    </a>
  ) : (
    <button class={classes} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
