---
/**
 * Section Heading Component
 * Consistent heading style across sections
 */

interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
}

const { id, title, subtitle, align = "left" } = Astro.props;

const alignClass = align === "center" ? "text-center mx-auto" : "";
---

<div class={`section-heading mb-16 ${alignClass} max-w-2xl`}>
  <h2
    id={id}
    class="text-3xl md:text-4xl font-black mb-4 text-text-main"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="text-base md:text-lg text-text-muted font-light leading-relaxed">
        {subtitle}
      </p>
    )
  }
</div>
