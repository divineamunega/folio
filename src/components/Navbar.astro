---
import { Moon } from "lucide-react";
import { Sun } from "lucide-react";
---

<header class="flex w-full items-center justify-center py-8 sm:px-28">
	<div
		class="flex w-full items-center justify-between rounded-4xl px-5 py-3 md:py-5"
	>
		<button class="btn-dark cursor-pointer">
			<Moon className="h-10 w-10 dark:hidden dark:text-white" />
			<Sun className="hidden dark:block dark:text-white" />
		</button>

		<a
			href="https://docs.google.com/document/d/1XrU7rW1uudym6_QTTDDnjun4rvh-2XfjRfOTb7geyQ0/edit?pli=1&tab=t.0#heading=h.y7d3xdxnr44m"
			target="_blank"
			class="dark:bg-pale-white dark:hover:bg-peach bg-peach hover:bg-pale-white border-cool-black hidden cursor-pointer border-2 px-2 py-2 transition-colors duration-300 md:block"
		>
			Resume
		</a>
		<a
			href="/divinne_resume.pdf"
			target="_blank"
			download="divinne_resume"
			class="dark:bg-pale-white dark:hover:bg-peach bg-peach hover:bg-pale-white border-cool-black cursor-pointer border-2 px-2 py-2 transition-colors duration-300 md:hidden"
		>
			Resume
		</a>
	</div>
</header>

<script>
	const button = document.querySelector(".btn-dark");

	button?.addEventListener("click", function () {
		document.querySelector("body")?.classList.toggle("dark");
	});
</script>
