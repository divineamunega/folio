---
/**
 * Tech Stack Section
 * Displays technology skills grid
 */

import Section from "../layout/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { techStack } from "../../config/tech-stack";
---

<Section ariaLabel="Technology stack and skills">
  <SectionHeading id="skills-heading" title="Stack" />

  <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-8 md:gap-12">
    {
      techStack.map((tech) => (
        <div
          class="skill-icon group flex flex-col items-center gap-3"
          data-category={tech.category}
        >
          <i
            class={`${tech.icon} text-5xl md:text-6xl opacity-60 group-hover:opacity-100 transition-opacity`}
          />
          <span class="text-xs font-mono text-[#666] dark:text-white/40">
            {tech.name}
          </span>
        </div>
      ))
    }
  </div>
</Section>
