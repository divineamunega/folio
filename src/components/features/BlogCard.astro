---
/**
 * Blog Card Component
 * Individual blog card for the blog grid
 */

import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";
import { siteConfig } from "../../config/site";

// Check environment for slug modification
const isDev = import.meta.env.DEV;

interface Props {
	slug: string;
	title: string;
	excerpt: string;
	date: string; // Should be a valid date string
	readTime: string; // e.g., '5'
	tags: string[];
}

let { slug, title, excerpt, date, readTime, tags } = Astro.props;

// --- Data Transformations ---

// Format the date string
const formattedDate = new Date(date).toDateString();

// Modify slug based on environment
const cardSlug = isDev ? slug.replace(siteConfig.url, "") : slug;

// Randomly select and slice up to 3 tags
const displayTags = [...tags].sort(() => 0.5 - Math.random()).slice(0, 3);
---

<Card href={cardSlug} class="blog-card group">
	<div class="space-y-5">
		<!-- Tags at top for visual interest -->
		<div class="blog-card-tags flex flex-wrap gap-2">
			{
				displayTags.map((tag: any) => (
					<Badge size="sm">{tag.name ? tag.name : tag}</Badge>
				))
			}
		</div>

		<!-- Title with better sizing -->
		<header>
			<h3
				class="blog-card-title group-hover:text-accent text-2xl leading-tight font-black text-text-main transition-colors md:text-3xl"
			>
				{title}
			</h3>
		</header>

		<!-- Excerpt with better prominence -->
		<p
			class="blog-card-excerpt text-base leading-relaxed text-text-muted"
		>
			{excerpt}
		</p>

		<!-- Metadata and action at bottom -->
		<div class="flex items-center justify-between gap-4 pt-2">
			<div
				class="flex items-center gap-3 text-xs font-medium text-text-muted"
			>
				<span class="blog-card-date">{formattedDate}</span>
				<span>•</span>
				<span class="blog-card-readtime">{readTime} min read</span>
			</div>

			<div
				class="blog-card-action group-hover:text-accent flex items-center gap-2 text-sm font-semibold text-text-muted transition-colors"
			>
				<span>Read</span>
				<Icon
					name="arrow-right"
					class="transition-transform group-hover:translate-x-1"
				/>
			</div>
		</div>
	</div>
</Card>

<style>
	.group:hover .group-hover\:text-accent {
		color: var(--color-accent);
	}

	.blog-card:hover .blog-card-excerpt {
		color: var(--color-text-primary);
	}
</style>
