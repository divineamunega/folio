---
/**
 * Testimonials Section
 * Displays client and peer feedback
 */

import Section from "../layout/Section.astro";
import Icon from "../ui/Icon.astro";
import { testimonials } from "../../data/testimonials";
---

<Section id="testimonials" ariaLabel="Client reviews and testimonials">
  <div class="split-layout">
    <div class="sidebar space-y-6">
      <div class="section-heading">
        <h2 class="text-3xl md:text-4xl font-medium tracking-tight text-text-main">
          Exhibition Reviews
        </h2>
        <p class="text-base text-text-muted font-light leading-relaxed max-w-sm mt-4">
          Peer critiques and client reviews on technical execution, system architecture, and product shipping.
        </p>
      </div>
    </div>
    <div class="reviews-list">
      {
        testimonials.map((item) => (
          <blockquote class="testimonial-item review-row space-y-6">
            <p class="text-lg md:text-xl font-light text-text-main leading-relaxed text-pretty">
              “{item.quote}”
            </p>
            <cite class="flex flex-wrap items-center justify-between gap-4 not-italic pt-2">
              <div class="space-y-1">
                <span class="font-medium text-sm text-text-main block">
                  {item.author}
                </span>
                <span class="font-mono text-xs text-text-muted block">
                  {item.role} {item.company && `at ${item.company}`}
                </span>
              </div>
              {item.projectSlug && (
                <a
                  href={`/projects/${item.projectSlug}`}
                  class="font-mono text-xs text-accent hover:text-accent-light transition-colors flex items-center gap-1.5"
                  aria-label={`View the ${item.company || 'project'} project details`}
                >
                  <span>Project record</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </a>
              )}
            </cite>
          </blockquote>
        ))
      }
    </div>
  </div>

  <style>
    .split-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    @media (min-width: 768px) {
      .split-layout {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 4rem;
      }
      .sidebar {
        grid-column: span 5;
        position: sticky;
        top: 7rem;
        height: fit-content;
      }
      .reviews-list {
        grid-column: span 7;
      }
    }
    .reviews-list {
      display: flex;
      flex-direction: column;
    }
    .review-row {
      display: block;
      border-bottom: 1px solid var(--color-border-default);
      transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
      padding: 3rem 0;
    }
    .review-row:first-child {
      border-top: 1px solid var(--color-border-default);
      padding-top: 0;
    }
    @media (min-width: 768px) {
      .review-row:first-child {
        border-top: none;
      }
    }
    .review-row:hover {
      border-color: var(--color-text-main);
    }
  </style>
</Section>
