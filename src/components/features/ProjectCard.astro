---
/**
 * Project Card Component
 * Individual project card for the projects grid
 */

import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  slug: string;
  title: string;
  description: string;
  year: string;
  tags: string[];
  featured?: boolean;
}

const { slug, title, description, year, tags, featured = false } = Astro.props;
---

<Card href={`/projects/${slug}`} class={`project_box ${featured ? 'md:col-span-2' : ''}`}>
  <div class={featured ? 'grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-start' : 'space-y-4'}>
    <!-- Details Column -->
    <div class={featured ? 'md:col-span-8 space-y-4' : 'space-y-4'}>
      {featured && (
        <span class="inline-block font-mono text-xs text-accent uppercase tracking-wider font-semibold">
          Featured Project
        </span>
      )}
      <div class="flex items-start justify-between gap-4">
        <h3
          class={`${featured ? 'text-2xl md:text-3xl' : 'text-xl'} font-bold text-text-main group-hover:text-accent transition-colors`}
        >
          {title}
        </h3>
        <span
          class="text-xs font-mono text-text-muted shrink-0 mt-1"
        >
          {year}
        </span>
      </div>

      <p class={`${featured ? 'text-base' : 'text-sm'} text-text-muted leading-relaxed`}>
        {description}
      </p>

      <div
        class="flex items-center gap-2 text-sm font-medium text-text-muted group-hover:text-accent transition-colors pt-2"
      >
        <span>View project</span>
        <Icon name="arrow-right" class="transition-transform group-hover:translate-x-1" />
      </div>
    </div>

    <!-- Tags Column -->
    <div class={featured ? 'md:col-span-4 flex flex-wrap gap-2 md:pt-8 md:justify-end' : 'flex flex-wrap gap-2'}>
      {
        tags.map((tag) => (
          <Badge size={featured ? 'md' : 'sm'} variant={featured ? 'accent' : 'default'}>
            {tag}
          </Badge>
        ))
      }
    </div>
  </div>
</Card>

<style>
  .group:hover .group-hover\:text-accent {
    color: var(--color-accent);
  }
</style>
