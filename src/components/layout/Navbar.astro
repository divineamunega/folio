---
/**
 * Navigation Bar
 * Fixed header with theme toggle and resume link
 */

import { siteConfig } from "../../config/site";
---

<nav
  class="border-border-default bg-bg-base/80 fixed top-0 right-0 left-0 z-50 border-b backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <!-- Logo/Monogram -->
    <a
      href="/"
      class="hover:text-accent text-text-main text-lg font-black transition-colors"
      aria-label="Home"
    >
      DA
    </a>

    <!-- Actions -->
    <div class="flex items-center gap-4">
      <!-- Projects Link -->
      <a
        href="/projects"
        class="hover:text-accent text-text-main text-sm font-medium transition-colors"
      >
        Projects
      </a>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="hover:text-accent text-text-main p-2 transition-colors"
        aria-label="Toggle theme"
      >
        <svg
          id="sun-icon"
          class="hidden h-5 w-5 dark:block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          id="moon-icon"
          class="block h-5 w-5 dark:hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <!-- Blog Link -->
      <a
        href={siteConfig.blog}
        class="hover:text-accent text-text-main text-sm font-medium transition-colors"
      >
        Blog
      </a>

    </div>
  </div>
</nav>

<style>
  .hover\:text-accent:hover {
    color: var(--color-accent);
  }
</style>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  const html = document.documentElement;
  const body = document.body;

  function updateIcons() {
    const isDark = body?.classList.contains("dark");
    const sunIcon = document.getElementById("sun-icon");
    const moonIcon = document.getElementById("moon-icon");

    if (isDark) {
      sunIcon?.classList.remove("hidden");
      moonIcon?.classList.add("hidden");
    } else {
      sunIcon?.classList.add("hidden");
      moonIcon?.classList.remove("hidden");
    }
  }

  // Set initial state
  updateIcons();

  themeToggle?.addEventListener("click", function () {
    const isDark = body?.classList.contains("dark");

    if (isDark) {
      body?.classList.remove("dark");
      html?.classList.remove("dark");
      localStorage.theme = "light";
    } else {
      body?.classList.add("dark");
      html?.classList.add("dark");
      localStorage.theme = "dark";
    }

    updateIcons();
  });
</script>
