---
import Navbar from "./Navbar.astro";
import { MoveDown } from "lucide-react";
---

<div class="sticky top-0 h-[140dvh] bg-white dark:bg-black">
	<Navbar />

	<div class="relative">
		<div class="flex items-center justify-center">
			<img src="/person.png" class="h-30" alt="" />
		</div>
		<div
			class="landing font-roboto flex w-full flex-col items-center justify-between gap-5 text-black"
		>
			<h1
				class="font-roboto xl:text-10xl dark:text-pale-white text-center text-4xl font-black text-wrap text-black transition-colors duration-500 sm:text-6xl lg:text-7xl"
			>
				Fullstack Developer
			</h1>
			<p
				class="reveal dark:text-pale-white px-4 text-center text-xl font-medium text-black sm:text-4xl md:px-10 lg:px-14 lg:text-4xl"
			>
				A creative fullstack developer who builds fast, secure, and scalable web
				apps—turning complex problems into clean, efficient systems.
			</p>

			<a
				href="mailto:divineamunega@gmail.com?subject=Hiring Inquiry&body=Hi%20Divine%2C%0D%0A%0D%0AI%20came%20across%20your%20profile%20and%20I'm%20interested%20in%20discussing%20a%20potential%20job%20opportunity.%0D%0A%0D%0ARegards%2C%0D%0A[Your Name]"
				class="dark:bg-pale-white bg-peach mx-auto block cursor-pointer rounded-sm border-2 border-black px-8 py-3 text-xl font-medium text-black transition-colors duration-300 hover:bg-white hover:text-black sm:mt-10 sm:px-10 sm:py-4 md:text-2xl hover:dark:bg-[#ffc965]"
			>
				Hire Me
			</a>

			<div
				class="flex flex-col items-center justify-center gap-10 pt-10 md:hidden"
			>
				<p class="text-cool-black dark:text-pale-white">Scroll</p>
				<MoveDown className="text-cool-black animate-bounce dark:text-white" />
			</div>
		</div>
	</div>
</div>

<script>
	import gsap from "gsap";
	import ScrollTrigger from "gsap/ScrollTrigger";
	import SplitText from "gsap/SplitText";
	import Lenis from "lenis";

	gsap.registerPlugin(ScrollTrigger, SplitText);

	const lenis = new Lenis({
		smoothWheel: true,
		duration: 1.6,
		easing: (t) => t * (2 - t),
		wheelMultiplier: 0.8,
	});

	function raf(time: number) {
		lenis.raf(time);
		requestAnimationFrame(raf);
	}
	requestAnimationFrame(raf);

	lenis.on("scroll", ScrollTrigger.update);
	gsap.ticker.lagSmoothing(0);

	// SplitText animation
	const splitType = document.querySelector(".reveal");
	if (splitType) {
		const text = new SplitText(splitType, { type: "chars" });

		gsap.from(text.chars, {
			scrollTrigger: {
				trigger: splitType,
				start: "top 70%",
				end: "top 0%",
				scrub: true,
			},
			opacity: 0.1,
			stagger: 0.05,
		});
	}

	if (window.innerWidth >= 768) {
		const projectsContainer = document.querySelector(".projects");
		const outerContainer = document.querySelector(".outer-container");

		if (projectsContainer && outerContainer) {
			const scrollWidth = projectsContainer.scrollWidth;
			const clientWidth = window.innerWidth;
			const scrollDistance = scrollWidth - clientWidth;

			gsap.to(projectsContainer, {
				x: -scrollDistance,
				ease: "none",
				scrollTrigger: {
					trigger: outerContainer,
					start: "top top",
					end: () => `+=${scrollDistance * 2}`,
					scrub: true,
					pin: true,
					invalidateOnRefresh: true,
				},
			});
		}
	}
</script>
