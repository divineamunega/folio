---
import ProjectCards from "./Project_Cards.astro";
---

<div
	class="outer-container text-cool-black dark:text-pale-white relative flex min-h-screen w-screen flex-col gap-10 overflow-hidden md:pt-20"
>
	<h1 class="text-center text-4xl font-bold">My Work</h1>
	<p class="px-10 text-center text-lg font-medium">
		A collection of my recent projects showcasing web development and design
		skills
	</p>

	<div
		class="projects flex flex-wrap items-center justify-center gap-20 self-start px-10 sm:w-full md:w-max md:flex-nowrap md:px-20"
	>
		<!-- Cards -->
		<ProjectCards
			imageUrl="/projects/project_1.png"
			title="Jersey.Co"
			description="An e-commerce site to buy the jerseys built with Astro and Tailwind CSS"
			liveSiteUrl="https://jerseyco.vercel.app/"
			githubUrl="https://github.com/divineamunega/jersey_co"
		/>

		<ProjectCards
			imageUrl="/projects/project_2.png"
			title="Plant Palace"
			description="A site to buy and sell plants built with HTML, CSS, and JS"
			liveSiteUrl="https://aptechota-plantpalace-cyberminds.vercel.app/"
			githubUrl="https://github.com/MhideTech/Techwiz-Project-PlantPalace"
		/>

		<ProjectCards
			imageUrl="/projects/project_3.png"
			title="Duo Video Share"
			description="A simple P2P video sharing app built with React and WebRTC"
			liveSiteUrl="https://duo-share-v2.vercel.app/"
			githubUrl=""
		/>

		<ProjectCards
			imageUrl="/projects/project_4.png"
			title="Get Linked Project "
			description="My submission for the Get Linked Hackathon. Built with Vanilla"
			liveSiteUrl="https://get-linked.netlify.app/"
			githubUrl="https://github.com/divineamunega/getlinked-tech-hackathon"
		/>

		<ProjectCards
			imageUrl="/projects/project_5.png"
			title="News Portal"
			description="A fullstack news portal built with React, Node.js, and MongoDB"
			liveSiteUrl="https://acu-news-portal.vercel.app/"
			githubUrl=""
		/>
	</div>
</div>
