---
/**
 * Project Detail Page
 * Dynamic page for individual project showcases
 */

import { Image } from "astro:assets";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import VideoPlayer from "../../components/ui/VideoPlayer.astro";
import { projects } from "../../data/projects";
import { siteConfig } from "../../config/site";

export function getStaticPaths() {
  return Object.keys(projects).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const project = projects[slug as keyof typeof projects];

if (!project) {
  return Astro.redirect("/404");
}

const title = `${project.title} - ${project.category} by ${siteConfig.author.name}`;
const description = `${project.description} Built with ${project.tags.join(", ")} by a professional ${project.category.toLowerCase()} specialist in Nigeria.`;
const image = project.imageUrl
  ? `${siteConfig.url}${project.imageUrl}`
  : siteConfig.ogImage;
const keywords = project.seoKeywords.join(", ");
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const collaboration =
  "collaborator" in project && "collaboratorUrl" in project
    ? { name: project.collaborator, url: project.collaboratorUrl }
    : null;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  keywords={keywords}
>
  <!-- Project Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      name: project.title,
      description: project.description,
      about: project.category,
      creator: {
        "@type": "Person",
        name: siteConfig.author.name,
        jobTitle: siteConfig.author.jobTitle,
        address: {
          "@type": "PostalAddress",
          addressLocality: siteConfig.author.addressRegion,
          addressCountry: siteConfig.author.addressCountry,
        },
      },
      keywords: project.seoKeywords,
      image: image,
      url: canonicalURL.toString(),
      dateCreated: project.year,
      inLanguage: "en",
      isAccessibleForFree: true,
    })}
  />

  <!-- Breadcrumb Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteConfig.url,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Projects",
          item: `${siteConfig.url}/projects`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: project.title,
          item: canonicalURL.toString(),
        },
      ],
    })}
  />

  <Navbar />

  <main class="bg-bg-base text-text-main min-h-screen px-6 pt-32 pb-20">
    <div class="mx-auto max-w-4xl">
      <!-- Back button -->
      <a
        href="/projects"
        class="text-text-muted hover:text-text-main mb-12 inline-flex items-center gap-2 text-sm transition-colors"
      >
        <Icon name="arrow-left" size="sm" />
        <span>Back to projects</span>
      </a>

      <!-- Header -->
      <div class="mb-12">
        <!-- Category badge -->
        <div class="mb-4">
          <span
            class="text-text-main bg-border-default inline-block rounded-full px-4 py-1.5 text-xs font-semibold"
          >
            {project.category}
          </span>
        </div>

        <div class="mb-4 flex items-start justify-between gap-4">
          <h1 class="text-text-main text-4xl font-black md:text-5xl">
            {project.title}
          </h1>
          <span class="text-text-muted shrink-0 font-mono text-sm">
            {project.year}
          </span>
        </div>
        <p
          class="text-text-muted text-lg leading-relaxed font-light md:text-xl"
        >
          {project.description}
        </p>
        {
          collaboration && (
            <p class="text-text-muted mt-3 text-sm">
              Co-built with{" "}
              {collaboration.url ? (
                <a
                  href={collaboration.url}
                  target="_blank"
                  rel="noreferrer"
                  class="text-text-main decoration-accent hover:text-accent font-medium underline underline-offset-4 transition-colors"
                >
                  {collaboration.name}
                </a>
              ) : (
                <span class="text-text-main font-medium">{collaboration.name}</span>
              )}
            </p>
          )
        }
      </div>

      <!-- Tags -->
      <div class="mb-12 flex flex-wrap gap-2">
        {project.tags.map((tag) => <Badge>{tag}</Badge>)}
      </div>

      <!-- Links -->
      <div
        class="mb-16 flex flex-wrap gap-4 border-b border-black/10 pb-16 dark:border-white/10"
      >
        {
          project.liveUrl && (
            <Button href={project.liveUrl} variant="primary" external>
              <span>View live site</span>
              <Icon name="external" />
            </Button>
          )
        }

        {
          project.githubUrl && (
            <Button href={project.githubUrl} variant="secondary" external>
              <span>View code</span>
              <Icon name="external" />
            </Button>
          )
        }
      </div>

      <!-- Project image/video -->
      {
        project.videoUrl && project.imageUrl ? (
          <div class="mb-16">
            <VideoPlayer
              videoUrl={project.videoUrl}
              imageUrl={project.imageUrl}
              title={project.title}
            />
          </div>
        ) : project.imageUrl ? (
          <div class="mb-16">
            <Image
              src={project.imageUrl}
              alt={`${project.title} project screenshot`}
              class="border-border-default w-full border"
              width={1200}
              height={675}
              loading="lazy"
              format="webp"
            />
          </div>
        ) : null
      }

      <!-- About section -->
      <div class="mb-16">
        <h2 class="text-text-main mb-4 text-2xl font-bold">About</h2>
        <p class="text-text-muted text-base leading-relaxed">
          {project.longDescription}
        </p>
      </div>

      <!-- Features -->
      <div class="mb-16">
        <h2 class="text-text-main mb-4 text-2xl font-bold">Key Features</h2>
        <ul class="space-y-3">
          {
            project.features.map((feature) => (
              <li class="text-text-muted flex items-start gap-3 text-base">
                <Icon name="check" class="text-accent mt-0.5 shrink-0" />
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Challenges -->
      {
        project.challenges && (
          <div class="mb-16">
            <h2 class="text-text-main mb-4 text-2xl font-bold">
              Challenges & Solutions
            </h2>
            <p class="text-text-muted text-base leading-relaxed">
              {project.challenges}
            </p>
          </div>
        )
      }
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .text-accent {
    color: var(--color-accent);
  }
</style>
