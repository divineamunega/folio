---
export const prerender = false;
/**
 * Blog Homepage
 * Displays all blog articles as a lead story and reading archive
 */

import BaseLayout from "../../components/layout/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import Section from "../../components/layout/Section.astro";
import Icon from "../../components/ui/Icon.astro";
import { fetchAllPublicationPosts } from "../../lib/api";
import { toBlogCardProps } from "../../lib/blog-card";

// Fetch blog posts from DEV Community
const posts = await fetchAllPublicationPosts();
const [featuredPost, ...archivePosts] = posts;
const featuredCard = featuredPost ? toBlogCardProps(featuredPost) : null;

function formatDate(date: string) {
  return new Date(date).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

// SEO metadata for blog index page
const pageTitle = "Blog | Divinne Amunega - Web Development Insights";
const pageDescription =
  "Technical articles and insights on React, TypeScript, Node.js, and modern web development. Learn best practices, advanced patterns, and performance optimization techniques.";
const pageKeywords =
  "web development blog, React tutorials, TypeScript guides, Node.js best practices, JavaScript articles, fullstack development, software engineering blog";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
>
  <Navbar />

  <Section id="blog-hero" noBorder={true} spacing="lg">
    <div class="grid gap-10 md:grid-cols-12 md:items-end">
      <h1
        class="text-text-main max-w-5xl text-[clamp(3.5rem,9vw,6rem)] leading-[0.92] font-black tracking-[-0.04em] text-balance md:col-span-9"
      >
        The writing archive.
      </h1>

      <div class="space-y-4 md:col-span-3 md:pb-2">
        <p
          class="text-text-main text-lg leading-relaxed font-medium text-pretty"
        >
          Writing, mostly because I love it.
        </p>
        <p
          class="text-text-muted max-w-[34ch] text-sm leading-relaxed text-pretty"
        >
          Technical notes, unfinished thoughts, and yearly reflections from a
          life spent building software.
        </p>
      </div>
    </div>
  </Section>

  <Section id="blog-articles" ariaLabel="Blog articles" spacing="sm">
    {
      featuredPost && featuredCard && (
        <article class="featured-story border-border-default grid overflow-hidden border md:grid-cols-12">
          {featuredPost.coverImage?.url && (
            <a
              href={featuredCard.slug}
              class="group bg-surface-card min-h-[20rem] overflow-hidden md:col-span-7 md:min-h-[38rem]"
              aria-label={`Read ${featuredPost.title}`}
            >
              <img
                src={featuredPost.coverImage.url}
                alt=""
                class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.025]"
              />
            </a>
          )}

          <a
            href={featuredCard.slug}
            class:list={[
              "featured-copy group bg-text-main text-bg-base flex min-h-[32rem] flex-col justify-between p-7 md:p-10 lg:p-12",
              featuredPost.coverImage?.url ? "md:col-span-5" : "md:col-span-12",
            ]}
          >
            <div class="flex flex-wrap items-start justify-between gap-5">
              <span class="text-bg-base/70 font-mono text-xs">
                Latest article
              </span>
              <div class="flex flex-wrap justify-end gap-2">
                {featuredCard.tags.slice(0, 3).map((tag) => (
                  <span class="bg-bg-base/10 text-bg-base px-2 py-1 font-mono text-xs">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="space-y-7">
              <h2 class="text-[clamp(2.25rem,4.5vw,4rem)] leading-[0.98] font-black tracking-[-0.035em] text-balance">
                {featuredPost.title}
              </h2>
              <p class="text-bg-base/75 max-w-[55ch] text-base leading-relaxed text-pretty">
                {featuredPost.brief}
              </p>

              <div class="border-bg-base/20 flex flex-wrap items-center justify-between gap-5 border-t pt-5">
                <div class="text-bg-base/70 flex items-center gap-3 font-mono text-xs">
                  <time datetime={featuredCard.date}>
                    {formatDate(featuredCard.date)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>{featuredCard.readTime} min read</span>
                </div>
                <Icon
                  name="arrow-right"
                  class="transition-transform duration-300 group-hover:translate-x-1.5"
                />
              </div>
            </div>
          </a>
        </article>
      )
    }

    {
      archivePosts.length > 0 && (
        <div class="pt-20 md:pt-28">
          <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
            <h2 class="text-text-main text-3xl font-bold tracking-[-0.02em] md:text-4xl">
              More from the archive
            </h2>
            <p class="text-text-muted max-w-sm text-sm leading-relaxed text-pretty">
              Every published note, newest first.
            </p>
          </div>

          <div class="archive-index border-border-default border-t">
            {archivePosts.map((post) => {
              const article = toBlogCardProps(post);

              return (
                <a
                  href={article.slug}
                  class="archive-entry group border-border-default grid gap-5 border-b py-8 transition-colors md:grid-cols-12 md:items-center md:gap-8 md:py-10"
                >
                  <div class="text-text-muted flex items-center justify-between gap-4 font-mono text-xs md:col-span-2 md:block">
                    <time datetime={article.date}>
                      {formatDate(article.date)}
                    </time>
                    <span class="md:mt-2 md:block">{article.readTime} min</span>
                  </div>

                  <div class="space-y-3 md:col-span-7">
                    <h3 class="text-text-main group-hover:text-accent max-w-3xl text-[clamp(1.5rem,3vw,2.6rem)] leading-[1.05] font-bold tracking-[-0.025em] text-balance transition-colors">
                      {article.title}
                    </h3>
                    <p class="text-text-muted max-w-[65ch] text-sm leading-relaxed text-pretty">
                      {article.excerpt}
                    </p>
                  </div>

                  <div class="flex items-end justify-between gap-5 md:col-span-3 md:justify-end">
                    <div class="flex flex-wrap gap-2 md:justify-end">
                      {article.tags.slice(0, 2).map((tag) => (
                        <span class="bg-border-default/40 text-text-muted px-2 py-1 font-mono text-xs">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <Icon
                      name="arrow-right"
                      class="text-text-muted group-hover:text-accent shrink-0 transition-all duration-300 group-hover:translate-x-1"
                    />
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )
    }
  </Section>

  <Footer />
</BaseLayout>

<style>
  .featured-story {
    background-color: var(--color-card-bg);
  }

  .featured-copy:hover {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
  }

  .archive-entry:hover {
    background-color: color-mix(
      in oklch,
      var(--color-card-bg) 82%,
      var(--color-border) 18%
    );
  }

  .archive-entry:focus-visible {
    outline-offset: -2px;
  }

  @media (min-width: 768px) {
    .archive-entry {
      padding-inline: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-story img,
    .featured-copy :global(svg),
    .archive-entry :global(svg) {
      transition: none;
    }
  }
</style>
