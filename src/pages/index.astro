---
import "../styles/global.css";
import Skills from "../components/Skills.astro";
import Landing from "../components/Landing.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/person.png" />
		<meta name="viewport" content="width=device-width" />

		<link
			rel="stylesheet"
			type="text/css"
			href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
		/>

		<meta name="generator" content={Astro.generator} />
		<title>Divinne | Creative Software Developer Portfolio</title>
		<meta
			name="description"
			content="Divinne - Creative Software Developer from Nigeria. Specialized in building modern web applications and innovative digital solutions."
		/>
		<meta
			name="keywords"
			content="Software Developer, Nigerian Developer, Creative Developer, Software Engineer, Web Developer, Frontend Developer, Portfolio, Tech Nigeria"
		/>

		<meta
			property="og:title"
			content="Divinne | Creative Software Developer Portfolio"
		/>
		<meta
			property="og:description"
			content="Creative Software Developer from Nigeria specialized in modern web development"
		/>
		<meta property="og:type" content="website" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta
			name="twitter:title"
			content="Divinne | Creative Software Developer Portfolio"
		/>
		<meta
			name="twitter:description"
			content="Creative Software Developer from Nigeria specialized in modern web development"
		/>
	</head>
	<body class="overflow-x-hidden transition-all duration-500">
		<Landing />

		<div
			class="font-roboto dark:bg-cool-black relative z-10 flex w-full flex-col items-center justify-center gap-30 bg-[#f5f5f5] pt-30"
		>
			<div>
				<Projects />
			</div>
			<Skills />
			<Contact />
			<Footer />
		</div>
	</body>
</html>
